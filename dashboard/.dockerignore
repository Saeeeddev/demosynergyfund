# Ignore development files and build artifacts
node_modules
.next
.git
.gitignore
README.md
AGENTS.md
CLAUDE.md

# Ignore all env files except .env.production (we'll handle that separately)
.env*
!.env.production

# Ignore editor files
.vscode
.idea
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore test and development artifacts
coverage
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Keep these for production
!public
!src
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!tailwind.config.ts
!postcss.config.mjs
!eslint.config.mjs
!middleware.ts
!next-env.d.ts
